# Tether Health — environment template
#
#   cp .env.example .env    # then fill in the blanks
#
# Every variable any service reads is listed here, grouped by what it is for.
# Nothing in this file is a real secret and nothing in it ever should be: `.env`
# is in `.gitignore`, `.env.example` is not, and the difference is one letter.
# Anything that looks like a credential below is a placeholder with the word
# CHANGE_ME or the word `local` in it.
#
# `@tether/core`'s `loadConfig` validates all of this at boot and lists every
# problem at once. A service that starts with half its configuration missing
# does not fail at boot; it fails at 3am on the one code path that needed the
# variable.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production. Controls log formatting, and whether
# notification-service refuses to start when Firebase credentials are present
# but unusable.
NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Where problem-detail `type` URIs resolve, and the public base of the API.
PUBLIC_API_URL=http://localhost:8000

# The host port the gateway publishes. It is the only published port in the
# whole stack; everything else is reachable only inside the compose network.
GATEWAY_HOST_PORT=8000

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Exact origins, comma-separated. Empty denies every browser origin, which is
# the correct default: a CORS list that falls back to `*` when unset is `*` in
# every environment somebody forgot to configure. The Flutter apps send no
# Origin header and are unaffected.
ALLOWED_ORIGINS=http://localhost:4321,https://www.tetherhealthgroup.com

# ---------------------------------------------------------------------------
# Tokens
# ---------------------------------------------------------------------------

# Asserted against the JWT's `iss`.
JWT_ISSUER=https://auth.tetherhealthgroup.com

# Asserted against the JWT's `aud`. A correctly signed token minted for a
# different audience in the same realm is a valid signature and the wrong
# caller; checking only the signature cannot tell them apart.
JWT_AUDIENCE=tether-api

# Where the issuer publishes its signing keys. Fetched and cached; a key
# rotation is picked up without a deploy.
JWT_JWKS_URL=https://auth.tetherhealthgroup.com/.well-known/jwks.json

# RS256 | ES256. Exactly one, ever. The repo this is modelled on passed
# ['ES256','HS256'] to every verification, offering the same configured string
# as both an HMAC secret and an ECDSA public key.
JWT_ALGORITHM=RS256

# ---------------------------------------------------------------------------
# The local database
# ---------------------------------------------------------------------------
#
# A real postgres:16-alpine in docker-compose.yml, not a remote one. The model
# repo pointed its "local dev" stack at production Supabase, which is how a
# development stack can corrupt live data.

POSTGRES_USER=tether
POSTGRES_PASSWORD=tether_local_only
POSTGRES_DB=tether

# Redis is a cache, and it still wants a password. An unauthenticated Redis is
# only ever one networking mistake from being an open one.
REDIS_PASSWORD=redis_local_only

# ---------------------------------------------------------------------------
# Per-service database roles
# ---------------------------------------------------------------------------
#
# One DSN per service, each with its own least-privileged role. This is the
# half the model repo skipped: it handed every service the Supabase
# service-role key, which bypasses row-level security, so its RLS policies
# could never fire.
#
# The local values below all use the superuser because a laptop database has
# nobody to isolate from. In every other environment these must be distinct
# roles with `GRANT`s limited to the schemas that service owns — and note that
# RLS is FORCED, so even the owning role is subject to its own policies.

GATEWAY_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
AUTH_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
CATALOGUE_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
ENROLMENT_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
RECORDS_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
CARE_TEAM_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
NOTIFICATION_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
WEBSITE_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether
CHRONIC_DATABASE_URL=postgres://tether:tether_local_only@postgres:5432/tether

# The migration runner needs DDL rights, which no service role has. Read by
# `db/migrate.ts`, which falls back to DATABASE_URL when this is unset.
MIGRATION_DATABASE_URL=postgres://tether:tether_local_only@localhost:5432/tether

# Connection-pool behaviour, shared by every service.
DB_POOL_MAX=10

# A slow query is a failed query. Milliseconds.
DB_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# HTTP limits
# ---------------------------------------------------------------------------

# Request body ceiling. One value for every service, so it cannot drift the way
# it had already drifted in the repo this is modelled on (1mb in one service,
# 512kb in the other nine).
BODY_LIMIT=512kb

# The service-wide limiter. Routes that need something tighter set their own;
# see WAITLIST_RATE_LIMIT_* below.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# notification-service
# ---------------------------------------------------------------------------

# Shared secret for `POST /send`, which is service-to-service and never reaches
# the gateway. No default and a 32-character minimum: the service refuses to
# start rather than start with a guessable one. Generate with
# `openssl rand -hex 32`.
INTERNAL_API_TOKEN=CHANGE_ME_openssl_rand_hex_32

# The Firebase service account, as one line of JSON.
#
# Deliberately blank here. Absent, notification-service starts and logs that
# push is disabled — device registration, preferences and the delivery log all
# still work. Local development must not require a Firebase project.
#
# In production this is injected by the secret store. It is never baked into an
# image and never written to a file in the repo: `.gitignore` already excludes
# `secrets/`, `*.p8` and `*.pem` so a stray key cannot reach a build context.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# website-service
# ---------------------------------------------------------------------------

# How long a repeat submission from the same address folds into the first.
# Long enough for a double tap and a retry; short enough that somebody
# enquiring again an hour later gets a second row rather than silence.
WAITLIST_DEDUPE_WINDOW_MS=900000

# The submission limit per IP. Far tighter than the service-wide default: this
# is the only unauthenticated write in the backend.
WAITLIST_RATE_LIMIT_MAX=5
WAITLIST_RATE_LIMIT_WINDOW_MS=3600000

# Rows deleted per call to `POST /waitlist/purge`. Batched so that a first run
# against a long backlog does not hold locks for minutes.
WAITLIST_PURGE_BATCH=1000

# The role a token must carry to run the retention purge.
ADMIN_ROLE=admin

# The site's own build-time variable, recorded here because the two have to
# agree. Set it in the Astro project, not in this file: with it unset the form
# composes a `mailto:` instead of posting, which is its default.
#   PUBLIC_WAITLIST_ENDPOINT=https://api.tetherhealthgroup.com/waitlist

# ---------------------------------------------------------------------------
# chronic-service
# ---------------------------------------------------------------------------

# How many readings one vitals request returns, and the ceiling a client can
# ask for. The Insights tab charts a trend, not a lifetime.
CHRONIC_VITALS_PAGE_DEFAULT=200
CHRONIC_VITALS_PAGE_MAX=500
